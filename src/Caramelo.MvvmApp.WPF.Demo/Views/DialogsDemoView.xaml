<caramelo:MvvmUserControl x:TypeArguments="vm:DialogsDemoViewModel"
                          x:Class="Caramelo.MvvmApp.WPF.Demo.Views.DialogsDemoView"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:caramelo="https://github.com/rftd/Caramelo.MvvmApp"
                          xmlns:vm="clr-namespace:Caramelo.MvvmApp.Demo.Core.ViewModels;assembly=Caramelo.MvvmApp.Demo.Core">
    <ScrollViewer Margin="24">
        <StackPanel MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="Demonstração do IDialogService" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
            <TextBlock Text="Dispare os diferentes tipos de diálogo suportados pela lib:" Margin="0,0,0,16" />

            <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Informação (InfoAsync)" Command="{Binding ShowInfoCommand}" Padding="8,4" Margin="0,0,12,12" />
                <Button Content="Aviso (WarnAsync)" Command="{Binding ShowWarningCommand}" Padding="8,4" Margin="0,0,12,12" />
                <Button Content="Erro (ErroAsync)" Command="{Binding ShowErrorCommand}" Padding="8,4" Margin="0,0,12,12" />
                <Button Content="Confirmação (ConfirmAsync)" Command="{Binding ShowConfirmCommand}" Padding="8,4" Margin="0,0,12,12" />
                <Button Content="Entrada de Texto (InputAsync)" Command="{Binding ShowInputCommand}" Padding="8,4" Margin="0,0,12,12" />
            </WrapPanel>

            <Border Background="#F2F2F2" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Resultado do último diálogo:" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding LastResult}" FontStyle="Italic" Foreground="DarkBlue" />
                </StackPanel>
            </Border>

            <Button Content="Voltar" Command="{Binding GoBackCommand}" Padding="8,4" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</caramelo:MvvmUserControl>
