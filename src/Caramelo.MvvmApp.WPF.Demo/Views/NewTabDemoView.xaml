<caramelo:MvvmUserControl x:TypeArguments="vm:NewTabDemoViewModel"
                          x:Class="Caramelo.MvvmApp.WPF.Demo.Views.NewTabDemoView"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:caramelo="https://github.com/rftd/Caramelo.MvvmApp"
                          xmlns:vm="clr-namespace:Caramelo.MvvmApp.Demo.Core.ViewModels;assembly=Caramelo.MvvmApp.Demo.Core">
    <ScrollViewer Margin="24">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="View em Nova Aba ([NewTab])" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
            <TextBlock Text="Esta tela foi aberta como uma nova aba porque sua ViewModel possui o atributo [NewTab]." Margin="0,0,0,16" />

            <Border Background="#F2F2F2" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Renomear esta aba dinamicamente:" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBox Text="{Binding EditableTitle, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" Padding="4" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Abrir Mais Uma Nova Aba" Command="{Binding OpenAnotherTabCommand}" Padding="8,4" Margin="0,0,12,0" />
                <Button Content="Navegar nesta Aba para Detalhes" Command="{Binding OpenDetailInsideThisTabCommand}" Padding="8,4" Margin="0,0,12,0" />
                <Button Content="Fechar Esta Aba" Command="{Binding CloseTabCommand}" Padding="8,4" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</caramelo:MvvmUserControl>
