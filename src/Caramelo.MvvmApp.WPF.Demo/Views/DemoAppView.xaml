<caramelo:MvvmWindow x:TypeArguments="view:DemoAppViewModel"
                     x:Class="Caramelo.MvvmApp.WPF.Demo.Views.DemoAppView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:view="clr-namespace:Caramelo.MvvmApp.Demo.Core.ViewModels;assembly=Caramelo.MvvmApp.Demo.Core"
                     xmlns:caramelo="https://github.com/rftd/Caramelo.MvvmApp"
                     mc:Ignorable="d" Height="650" Width="950" Title="Caramelo.MvvmApp Demo (WPF)">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#2196F3" Padding="12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Caramelo.MvvmApp WPF Demo" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>

                <Button Content="Início" Command="{Binding OpenHomeCommand}" Padding="10,6" Margin="0,0,8,0" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Nova Aba ([NewTab])" Command="{Binding OpenNewTabCommand}" Padding="10,6" Margin="0,0,8,0" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Diálogos" Command="{Binding OpenDialogsCommand}" Padding="10,6" Margin="0,0,8,0" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Navegação c/ Resultado" Command="{Binding OpenResultDemoCommand}" Padding="10,6" Margin="0,0,8,0" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Navegação Protegida" Command="{Binding OpenGuardedDemoCommand}" Padding="10,6" Background="#1976D2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>
        </Border>

        <!-- Tabbed Host Content -->
        <caramelo:TabbedRoutedViewHost Grid.Row="1" Router="{Binding Router}" />
    </Grid>
</caramelo:MvvmWindow>
