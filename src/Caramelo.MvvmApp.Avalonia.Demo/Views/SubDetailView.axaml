<caramelo:MvvmUserControl x:TypeArguments="vm:SubDetailViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
                          xmlns:caramelo="https://github.com/rftd/Caramelo.MvvmApp"
                          xmlns:vm="clr-namespace:Caramelo.MvvmApp.Demo.Core.ViewModels;assembly=Caramelo.MvvmApp.Demo.Core"
                          x:DataType="vm:SubDetailViewModel"
                          x:Class="Caramelo.MvvmApp.Avalonia.Demo.Views.SubDetailView">
    <ScrollViewer Margin="24">
        <StackPanel Spacing="16" MaxWidth="650" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Sub-Detalhe (Nível 3 da Aba)"
                           FontSize="{actipro:ThemeResource HeadingFontSizeLarge}"
                           FontWeight="Bold" />
                <TextBlock Text="Você está no 3º nível do histórico desta aba. Ao clicar em Voltar, você retornará para o Nível 2 (DetailView)."
                           Foreground="{actipro:ThemeResource DefaultForegroundBrushSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Classes="theme-outline" Content="Voltar para Nível 2" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</caramelo:MvvmUserControl>
