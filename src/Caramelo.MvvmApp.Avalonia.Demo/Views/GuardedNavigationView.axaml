<caramelo:MvvmUserControl x:TypeArguments="vm:GuardedNavigationViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
                          xmlns:caramelo="https://github.com/rftd/Caramelo.MvvmApp"
                          xmlns:vm="clr-namespace:Caramelo.MvvmApp.Demo.Core.ViewModels;assembly=Caramelo.MvvmApp.Demo.Core"
                          x:DataType="vm:GuardedNavigationViewModel"
                          x:Class="Caramelo.MvvmApp.Avalonia.Demo.Views.GuardedNavigationView">
    <ScrollViewer Margin="24">
        <StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Navegação com Interceptação (CanNavigateAsync)"
                           FontSize="{actipro:ThemeResource HeadingFontSizeLarge}"
                           FontWeight="Bold" />
                <TextBlock Text="Esta tela implementa CanNavigateAsync para confirmar com o usuário caso haja alterações não salvas antes de sair ou fechar."
                           Foreground="{actipro:ThemeResource DefaultForegroundBrushSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{actipro:ThemeResource Container1BackgroundBrush}"
                    BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <ToggleSwitch IsChecked="{Binding HasUnsavedChanges, Mode=TwoWay}"
                              OnContent="Alterações não salvas pendentes (Bloquear saída)"
                              OffContent="Sem alterações pendentes (Permitir saída)" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="theme-soft warning" Content="Tentar Voltar / Fechar" Command="{Binding GoBackCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</caramelo:MvvmUserControl>
