<caramelo:MvvmUserControl x:TypeArguments="vm:ParametersDemoViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:caramelo="https://github.com/rftd/Caramelo.MvvmApp"
                          xmlns:vm="clr-namespace:Caramelo.MvvmApp.Demo.Core.ViewModels;assembly=Caramelo.MvvmApp.Demo.Core"
                          x:DataType="vm:ParametersDemoViewModel"
                          x:Class="Caramelo.MvvmApp.Avalonia.Demo.Views.ParametersDemoView">
    <ScrollViewer Margin="24">
        <StackPanel Spacing="16" MaxWidth="650" HorizontalAlignment="Left">
            <TextBlock Text="Navegação com Retorno de Resultado" Theme="{StaticResource Headline6SubheadlineText}" FontWeight="Bold" />
            <TextBlock Text="Demonstra o uso de GoToAsync&lt;TModel, TParam, TResult&gt; e GoBackAsync(this, result)." TextWrapping="Wrap" />

            <Button Content="Abrir Tela e Aguardar Retorno" Command="{Binding RequestResultCommand}" />

            <Border Background="#10000000" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Resultado recebido da tela filha:" FontWeight="Bold" />
                    <TextBlock Text="{Binding ReturnedResult}" FontStyle="Italic" Foreground="DarkMagenta" />
                </StackPanel>
            </Border>

            <Button Content="Voltar" Command="{Binding GoBackCommand}" />
        </StackPanel>
    </ScrollViewer>
</caramelo:MvvmUserControl>
