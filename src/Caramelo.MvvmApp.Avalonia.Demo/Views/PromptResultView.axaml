<caramelo:MvvmUserControl x:TypeArguments="vm:PromptResultViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
                          xmlns:caramelo="https://github.com/rftd/Caramelo.MvvmApp"
                          xmlns:vm="clr-namespace:Caramelo.MvvmApp.Demo.Core.ViewModels;assembly=Caramelo.MvvmApp.Demo.Core"
                          x:DataType="vm:PromptResultViewModel"
                          x:Class="Caramelo.MvvmApp.Avalonia.Demo.Views.PromptResultView">
    <ScrollViewer Margin="24">
        <StackPanel Spacing="16" MaxWidth="650" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Tela Filha com Retorno de Resultado"
                           FontSize="{actipro:ThemeResource HeadingFontSizeLarge}"
                           FontWeight="Bold" />
                <TextBlock Text="Digite o valor que deseja retornar para a tela anterior:"
                           Foreground="{actipro:ThemeResource DefaultForegroundBrushSecondary}" />
            </StackPanel>

            <TextBox Text="{Binding InputResult, Mode=TwoWay}" Width="350" HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="theme-solid success" Content="Confirmar e Retornar" Command="{Binding ConfirmResultCommand}" />
                <Button Classes="theme-outline" Content="Cancelar" Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</caramelo:MvvmUserControl>
