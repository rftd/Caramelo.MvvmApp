<caramelo:MvvmUserControl x:TypeArguments="vm:NewTabDemoViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
                          xmlns:caramelo="https://github.com/rftd/Caramelo.MvvmApp"
                          xmlns:vm="clr-namespace:Caramelo.MvvmApp.Demo.Core.ViewModels;assembly=Caramelo.MvvmApp.Demo.Core"
                          x:DataType="vm:NewTabDemoViewModel"
                          x:Class="Caramelo.MvvmApp.Avalonia.Demo.Views.NewTabDemoView">
    <ScrollViewer Margin="24">
        <StackPanel Spacing="16" MaxWidth="650" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="View em Nova Aba ([NewTab])"
                           FontSize="{actipro:ThemeResource HeadingFontSizeLarge}"
                           FontWeight="Bold" />
                <TextBlock Text="Esta tela foi aberta como uma nova aba porque sua ViewModel possui o atributo [NewTab]."
                           Foreground="{actipro:ThemeResource DefaultForegroundBrushSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{actipro:ThemeResource Container1BackgroundBrush}"
                    BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Renomear esta aba dinamicamente:" FontWeight="SemiBold" />
                    <TextBox Text="{Binding EditableTitle, Mode=TwoWay}" Width="300" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <WrapPanel Orientation="Horizontal">
                <Button Classes="theme-solid accent" Content="Abrir Mais Uma Nova Aba" Command="{Binding OpenAnotherTabCommand}" Margin="0,0,12,12" />
                <Button Classes="theme-soft" Content="Navegar nesta Aba para Detalhes" Command="{Binding OpenDetailInsideThisTabCommand}" Margin="0,0,12,12" />
                <Button Classes="theme-soft danger" Content="Fechar Esta Aba" Command="{Binding CloseTabCommand}" Margin="0,0,12,12" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</caramelo:MvvmUserControl>
